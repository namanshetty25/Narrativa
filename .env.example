# ============================================
# Narrativa — Environment Variables
# ============================================
# Copy this file to `.env` and fill in your values:
#   cp .env.example .env

# === Required ===

# Google Gemini API Key (get one at https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_gemini_api_key_here

# Neon / Supabase / any Postgres connection string
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# === Optional (Production) ===

# URL of the deployed Python backend (defaults to http://localhost:8000 in dev)
# PYTHON_API_URL=https://your-python-backend.onrender.com

# Vercel Blob token for storing generated slides/audio in production
# BLOB_READ_WRITE_TOKEN=your_vercel_blob_token_here
