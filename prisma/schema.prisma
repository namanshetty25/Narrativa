// Narrativa Database Schema — SQLite via Prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Session {
  id        String   @id @default(uuid())
  title     String   @default("New Chat")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages       Message[]
  sources        Source[]
  artifacts      Artifact[]
  researchReports ResearchReport[]
}

model Message {
  id        String   @id @default(uuid())
  sessionId String
  role      String   // 'user' or 'ai'
  content   String
  createdAt DateTime @default(now())

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model Source {
  id        String   @id @default(uuid())
  sessionId String
  name      String
  type      String
  text      String
  createdAt DateTime @default(now())

  session Session         @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  chunks  DocumentChunk[]
}

model DocumentChunk {
  id       String @id @default(uuid())
  sourceId String
  text     String

  source Source @relation(fields: [sourceId], references: [id], onDelete: Cascade)
}

model Artifact {
  id        String   @id @default(uuid())
  sessionId String
  type      String   // 'audio', 'summary', 'slides'
  label     String
  sourceIds String   // JSON array of source IDs
  url       String?
  content   String?
  script    String?
  createdAt DateTime @default(now())

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model ResearchReport {
  id            String   @id @default(uuid())
  sessionId     String
  topic         String
  content       String
  papersSummary String   // JSON array of {title, url, abstract}
  createdAt     DateTime @default(now())

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}
